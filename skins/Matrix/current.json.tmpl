#set $obs_names = $to_list($DisplayOptions.get('observations_current', [])) + $to_list($DisplayOptions.get('observations_extended', []))
#set $seen = []
#set $export_obs = []
#for $obs in $obs_names
#if $obs not in $seen and $getVar('year.%s.has_data' % $obs, False)
#set $void = $seen.append($obs)
#set $void = $export_obs.append($obs)
#end if
