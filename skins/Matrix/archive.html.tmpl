## archive.html.tmpl -- Matrix skin deep archive index.
## Lets the user jump to any month or year of station history.
#errorCatcher Echo
#encoding UTF-8
#set global $rel = ""
#set global $nav_current = "archive"
#set $months = list(reversed(list($SummaryByMonth)))
#set $years = list(reversed(list($SummaryByYear)))
<!DOCTYPE html>
<html lang="$lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  #include "theme-init.inc"
  <title>$gettext("Archive") :: $station.location :: MATRIX_OS</title>
  <link rel="icon" type="image/svg+xml" href="static/favicon.svg">
  <link rel="stylesheet" href="static/matrix.css?v=$SKIN_VERSION">
</head>
<body>
  <canvas id="rain"></canvas>
  <div class="crt">

    #include "titlebar.inc"

    <main class="terminal">

      <section class="panel">
        <h2>$gettext("Deep Archive")</h2>
        <p>$gettext("Deep archive intro")</p>

        <div class="archive-select">
          <div>
            <label for="jump-month">$gettext("Jump to") &mdash; $gettext("Monthly Records")</label>
            <select id="jump-month" onchange="gotoArchive('archive/month-', this.value)">
              <option selected disabled>$gettext("select month")</option>
              #for $monthYear in $months
              <option value="$monthYear">$monthYear</option>
              #end for
            </select>
          </div>
          <div>
            <label for="jump-year">$gettext("Jump to") &mdash; $gettext("Yearly Records")</label>
            <select id="jump-year" onchange="gotoArchive('archive/year-', this.value)">
              <option selected disabled>$gettext("select year")</option>
              #for $yr in $years
              <option value="$yr">$yr</option>
              #end for
            </select>
          </div>
        </div>
      </section>

      #if $years
      <section class="panel">
        <h3>$gettext("Yearly Records")</h3>
        <div class="dir-listing">
          #for $yr in $years
          <a href="archive/year-${yr}.html">year-${yr}.html</a>
          #end for
        </div>
      </section>
      #end if

      #if $months
      <section class="panel">
        <h3>$gettext("Monthly Records")</h3>
        <div class="dir-listing">
          #for $monthYear in $months
          <a href="archive/month-${monthYear}.html">month-${monthYear}.html</a>
          #end for
        </div>
      </section>
      #end if

      #if not $years and not $months
      <section class="panel">
        <p class="empty-note">$gettext("No records found")</p>
      </section>
      #end if

    </main>

    #include "footer.inc"
  </div>

  <script src="static/matrix.js?v=$SKIN_VERSION" defer></script>
  #if $to_bool($Extras.get('enable_shell', True))
  <script src="static/shell.js?v=$SKIN_VERSION" defer></script>
  #end if
</body>
</html>
